const { Duplex } = require('node:stream');
const fs = require('node:fs');

class DuplexStream extends Duplex {
    constructor({ readableHighWaterMark, writableHighWaterMark, readFileName, writeFileName }) {
        super({ readableHighWaterMark, writableHighWaterMark });
        this.readFileName = readFileName;
        this.writeFileName = writeFileName;
        this.writeFd = null;
        this.readFd = null;
        this.chunks = [];
        this.chuksSize = 0;
    }

    _construct(callback) {
        fs.open(this.readFileName, 'r', (err, readFd) => {
            if (err) {
                return callback(err);
            }
            this.readFd = readFd;

            fs.open(this.writeFileName, 'w', (err, writeFd) => {
                if (err) {
                    return callback(err);
                }
                this.writeFd = writeFd;
                callback();
            })
        })
    }

    _write(chunk, encoding, callback) {
        this.chunks.push(chunk);
        this.chuksSize += chunk.length;

        if (this.chuksSize > this.writableHighWaterMark) {
            fs.write(this.writeFd, Buffer.concat(this.chunks), (err) => {
                if (err) {
                    return callback(err);
                } else {
                    this.chunks = [];
                    this.chuksSize = 0;
                    callback();
                }
            })
        } else {
            // when we're done, we should call the callback
            callback(null);
        }
    }

    _read(size) {
        const buff = Buffer.alloc(size);
        fs.read(this.readFd, buff, 0, size, null, (err, bytesRead) => {
            if (err) return this.destroy(err);
            this.push(bytesRead > 0 ? buff.subarray(0, bytesRead) : null);
        })
    }

    _final(callback) {
        fs.write(this.writeFd, Buffer.concat(this.chunks), (err) => {
            if (err) {
                return callback(err);
            } else {
                this.chunks = [];
                this.chuksSize = 0;
                callback();
            }
        });
    }

    _destroy(error, callback) {
        const closeRead = (writeErr) => {
            if (this.readFd) {
                fs.close(this.readFd, (readErr) => {
                    callback(error || writeErr || readErr);
                })
            } else {
                callback(error || writeErr);
            }
        }

        if (this.writeFd) {
            fs.close(this.writeFd, closeRead);
        } else {
            closeRead(null);
        }
    }
}

const duplexStream = new DuplexStream({ readFileName: './read.txt', writeFileName: './write.txt'})
duplexStream.write(Buffer.from("sameeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeer"));

duplexStream.on('data', (chunk) => {
    console.log("data>>>>", chunk.toString('utf-8'));
})
duplexStream.end("end of write")
